x = sp.add_parser('previa'); x.add_argument('ep'); x.set_defaults(f=cmd_previa)
x = sp.add_parser('finalizar'); x.add_argument('ep'); x.add_argument('titulo'); x.add_argument('--destino'); x.set_defaults(f=cmd_finalizar)
x = sp.add_parser('entregar'); x.add_argument('ep'); x.add_argument('titulo'); x.add_argument('--destino'); x.set_defaults(f=cmd_entregar)
a = p.parse_args(); a.f(a)
